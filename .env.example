# Copy to .env (gitignored) and fill in. Loaded automatically by GatewayConfig
# from the directory containing gateway.json. The real environment takes precedence.

# Notion internal integration token — https://www.notion.so/profile/integrations
# Starts with ntn_. The integration must also be granted access to each page or
# teamspace you want visible, or it authenticates fine and sees nothing.
NOTION_TOKEN=ntn_

# GitHub PAT for the hosted MCP server at api.githubcopilot.com.
# https://github.com/settings/tokens — classic token, scopes: repo, read:org, read:user
GITHUB_MCP_TOKEN=

# Anthropic key for messages.count_tokens, used to measure real per-schema costs.
# https://console.anthropic.com/settings/keys — count_tokens itself is free.
ANTHROPIC_API_KEY=
