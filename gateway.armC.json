{
  "mode": "live",
  "arm": "C-semantic",
  "budget_tokens": 3000,
  "log_dir": "runs/bench/C",
  "catalog_path": "results/catalog.json",
  "pinned": [],
  "model": "claude-opus-5",
  "upstreams": [
    {
      "server_id": "playwright",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    },
    {
      "server_id": "notion",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    {
      "server_id": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    }
  ],
  "selector": "semantic"
}
